# Development and production may use different DB_HOST values.
# Never commit real credentials.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# SMTP Configuration (Hostinger Email)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@trevoone.com
SMTP_PASSWORD=
MAIL_FROM=Trevo One <no-reply@trevoone.com>

# Canonical application URL for reset links
APP_URL=http://localhost:3000

# Private storage root directory for uploaded receipts/files (required in production, fallback to .data/private in dev)
PRIVATE_STORAGE_ROOT=

# Cloudflare Realtime TURN Configuration
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_KEY_API_TOKEN=

# Consultation Reminders Cron Secret (Internal global processor authorization)
CONSULTATION_REMINDERS_CRON_SECRET=

# Authentication Rate Limiting HMAC Secret (Server-only, required in production)
AUTH_RATE_LIMIT_HMAC_SECRET=

# Origin Guard Configuration (Cloudflare edge-to-origin request verification)
# Supported modes: disabled | observe | enforce (defaults to disabled when unset or empty)
ORIGIN_GUARD_MODE=
# 32 cryptographically random bytes encoded as 64 hex characters (server-only, required when mode=enforce)
ORIGIN_GUARD_SECRET=
