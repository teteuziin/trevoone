# Development and production may use different DB_HOST values.
# Never commit real credentials.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# SMTP Configuration (Hostinger Email)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@trevoone.com
SMTP_PASSWORD=
MAIL_FROM=Trevo One <no-reply@trevoone.com>

# Canonical application URL for reset links
APP_URL=http://localhost:3000

# Private storage root directory for uploaded receipts/files (required in production, fallback to .data/private in dev)
PRIVATE_STORAGE_ROOT=
